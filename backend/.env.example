# Server
NODE_ENV=development
PORT=5001

# Database
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/fixmycity

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies / CORS
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false

# Files
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5

# Seed (Super Admin)
SEED_SUPER_ADMIN_EMAIL=superadmin@fixmycity.uz
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin123!
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin

# AI (Groq) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_ANALYSIS_MODEL=llama-3.3-70b-versatile
AI_CHAT_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.3
